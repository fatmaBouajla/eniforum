digraph G {
graph [rankdir=TB, splines=true, nodesep=0.5, ranksep=0.9, fontname="Inter", bgcolor="white", pad=0.2];
node [shape=plaintext, fontname="Inter", fontsize=10];
edge [fontname="Inter", fontsize=8.5, color="#475569", arrowhead=vee, arrowsize=0.7, fontcolor="#334155"];
ForumProject [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8">
<TR><TD BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>ForumProject</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- nom : String<BR ALIGN="LEFT"/>- edition : String<BR ALIGN="LEFT"/>- dateDebut : LocalDate<BR ALIGN="LEFT"/>- dateEvenement : LocalDate<BR ALIGN="LEFT"/>- lieu : String<BR ALIGN="LEFT"/>- description : String<BR ALIGN="LEFT"/>- statut : StatutProjet<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F8FAFC">+ archiver()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Comite [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8">
<TR><TD BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>Comite</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- nom : String<BR ALIGN="LEFT"/>- description : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Utilisateur [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8">
<TR><TD BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>Utilisateur</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- nom : String<BR ALIGN="LEFT"/>- email : String<BR ALIGN="LEFT"/>- motDePasse : String (BCrypt)<BR ALIGN="LEFT"/>- actif : boolean<BR ALIGN="LEFT"/>- role : RoleEnum<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Tache [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8">
<TR><TD BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>Tache</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- titre : String<BR ALIGN="LEFT"/>- description : String<BR ALIGN="LEFT"/>- dateDebut : LocalDate<BR ALIGN="LEFT"/>- dateFin : LocalDate<BR ALIGN="LEFT"/>- priorite : PrioriteTache<BR ALIGN="LEFT"/>- statut : StatutTache<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F8FAFC">+ detecterRetard()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Commentaire [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8">
<TR><TD BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>Commentaire</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- contenu : String<BR ALIGN="LEFT"/>- dateCreation : LocalDateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Workshop [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8">
<TR><TD BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>Workshop</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- titre : String<BR ALIGN="LEFT"/>- description : String<BR ALIGN="LEFT"/>- intervenant : String<BR ALIGN="LEFT"/>- dateHeure : LocalDateTime<BR ALIGN="LEFT"/>- statut : StatutWorkshop<BR ALIGN="LEFT"/>- motifRefus : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F8FAFC">+ valider()<BR ALIGN="LEFT"/>+ refuser(motif)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Notification [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8">
<TR><TD BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>Notification</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- message : String<BR ALIGN="LEFT"/>- lu : boolean<BR ALIGN="LEFT"/>- dateEnvoi : LocalDateTime<BR ALIGN="LEFT"/>- type : TypeNotification<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CandidatureCV [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8">
<TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white"><B>CandidatureCV</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- fichierCV : String<BR ALIGN="LEFT"/>- posteVise : String<BR ALIGN="LEFT"/>- dossierComplet : String<BR ALIGN="LEFT"/>- candidatNom : String<BR ALIGN="LEFT"/>- candidatEmail : String<BR ALIGN="LEFT"/>- statut : StatutCandidature<BR ALIGN="LEFT"/>- commentaire : String<BR ALIGN="LEFT"/>- dateDepot : LocalDateTime<BR ALIGN="LEFT"/>- scoreIA : Double<BR ALIGN="LEFT"/>- justificationIA : Text<BR ALIGN="LEFT"/>- competencesExtraites : String<BR ALIGN="LEFT"/>- dateAnalyseIA : LocalDateTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F8FAFC">+ analyserIA()<BR ALIGN="LEFT"/>+ accepter()<BR ALIGN="LEFT"/>+ refuser(motif)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AuditLog [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8">
<TR><TD BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>AuditLog</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- action : String<BR ALIGN="LEFT"/>- details : String<BR ALIGN="LEFT"/>- dateAction : LocalDateTime<BR ALIGN="LEFT"/>- utilisateur : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

ForumProject -> Comite [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*", label=" comprend"];
Comite -> Utilisateur [taillabel="0..1", headlabel="1", label=" chef"];
Comite -> Utilisateur [taillabel="0..*", headlabel="0..*", label=" membres"];
Tache -> Comite [taillabel="0..*", headlabel="1", label=" appartient à"];
Tache -> Utilisateur [taillabel="0..*", headlabel="0..1", label=" assignée à"];
Tache -> Commentaire [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
Commentaire -> Utilisateur [taillabel="0..*", headlabel="1", label=" auteur"];
Workshop -> Comite [taillabel="0..*", headlabel="1", label=" organisé par"];
Workshop -> Utilisateur [taillabel="0..*", headlabel="0..1", label=" proposé par"];
Notification -> Utilisateur [taillabel="0..*", headlabel="1", label=" destinataire"];
Notification -> Tache [taillabel="0..*", headlabel="0..1", style=dashed];
CandidatureCV -> ForumProject [taillabel="0..*", headlabel="0..1", label=" édition"];
CandidatureCV -> Utilisateur [taillabel="0..1", headlabel="0..1", label=" compte créé", style=dashed];

}