digraph UC {
graph [rankdir=LR, fontname="Inter", nodesep=0.18, ranksep=1.1, pad=0.2, newrank=true];
node [fontname="Inter", fontsize=10];
edge [color="#64748B", arrowhead=none, penwidth=0.9];

node [shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#6366F1", fontcolor="#1E1B4B", width=1.5];
Admin [label="Administrateur"]; Pilotage [label="Comité de pilotage"]; Coord [label="Coordinatrice"];
Chef [label="Chef de comité"]; Membre [label="Membre"]; Candidat [label="Candidat\n(visiteur)"];

subgraph cluster_sys {
  label="Plateforme EniForum"; fontsize=13; fontcolor="#1E3A8A"; style="rounded,dashed"; color="#3B82F6"; margin=16;
  node [shape=ellipse, style=filled, fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#0F172A", width=2.6, fontsize=9.5];
  login [label="Se connecter (JWT)"];
  projet [label="Créer / archiver le projet Forum"];
  users [label="Gérer les utilisateurs et rôles"];
  comites [label="Gérer les comités"];
  stats [label="Consulter statistiques et historique"];
  suivi [label="Suivre l'avancement des comités"];
  cvs [label="Valider / refuser les candidatures"];
  ia [label="Classer et comparer les CV (IA)", fillcolor="#EDE9FE", color="#7C3AED"];
  analyse [label="Analyser un CV (score + justification)", fillcolor="#EDE9FE", color="#7C3AED"];
  planning [label="Valider plannings, réassigner, prioriser"];
  workshops [label="Valider / refuser les workshops"];
  proposer [label="Proposer un workshop"];
  membres [label="Gérer les membres du comité"];
  taches [label="Créer et assigner des tâches"];
  mesTaches [label="Mettre à jour ses tâches, commenter"];
  notifs [label="Recevoir des notifications"];
  depot [label="Déposer sa candidature (CV PDF)"];
}

node [shape=box, style="rounded,filled", fillcolor="#FFF7ED", color="#F97316", fontcolor="#7C2D12", width=1.4];
IA [label="Service IA"]; Mail [label="Serveur mail"];

Admin -> {login projet users comites stats};
Pilotage -> {login suivi cvs ia stats};
Coord -> {login suivi planning workshops notifs};
Chef -> {login membres taches proposer notifs};
Membre -> {login mesTaches notifs};
Candidat -> depot;

edge [style=dashed, arrowhead=vee, fontsize=8, fontcolor="#7C3AED", color="#A78BFA"];
ia -> analyse [label="«include»"];
depot -> analyse [label="«include»"];
cvs -> analyse [label="«extend»", style=dotted];
analyse -> IA [arrowhead=none, color="#F97316", style=solid];
cvs -> Mail [arrowhead=none, color="#F97316", style=solid];
}
