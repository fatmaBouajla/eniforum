# Copiez ce fichier en ".env" à côté de docker-compose.yml (il est ignoré par git).
# Toutes les valeurs sont facultatives : les valeurs par défaut suffisent pour une démo.

# --- Images Docker Hub ---
DOCKERHUB_USER=fatmabouajla
ENIFORUM_TAG=latest

# --- Ports sur votre machine ---
APP_PORT=4200
API_PORT=8081
AI_PORT=8000

# --- Base de données ---
DB_PASSWORD=eniforum

# --- Sécurité : générez votre clé avec  openssl rand -base64 48 ---
JWT_SECRET=

# --- Compte administrateur (créé ou promu au démarrage du backend) ---
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@eniforum.tn
ADMIN_PASSWORD=Admin@2026

# --- Données de démonstration (comptes, tâches, candidatures) ---
DEMO_DATA=true

# --- Modèle de langage de l'analyse détaillée (qwen2.5:1.5b = plus rapide, moins précis) ---
OLLAMA_MODEL=qwen2.5:3b

# --- Envoi des emails (Gmail + mot de passe d'application) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- URL publique du frontend (liens dans les emails) ---
FRONTEND_URL=http://localhost:4200
